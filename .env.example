# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  cp .env.example .env
#
# 시크릿 생성(리눅스/맥/Git Bash):
#   openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 24   # DB_PASSWORD, XOR_KEY 용
#   openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 20   # GZCTF_ADMIN_PASSWORD 용

# Postgres 비밀번호
DB_PASSWORD=CHANGE_ME_db

# 최초 관리자(Admin) 계정 비밀번호 — 첫 기동 시 이 값으로 Admin 계정이 생성됨
GZCTF_ADMIN_PASSWORD=CHANGE_ME_admin

# flag 암호화 키 (절대 외부 유출 금지)
XOR_KEY=CHANGE_ME_xorkey

# 참가자에게 안내될 인스턴스 접속 호스트 (예: nc <PUBLIC_ENTRY> 32xxx)
#   로컬 테스트: localhost
#   실서버: 서버 공인 IP 또는 도메인 (예: chal.example.com)
PUBLIC_ENTRY=localhost

# Caddy(HTTPS)가 인증서를 발급받을 웹 도메인 — 실서버(--profile prod)에서만 사용
DOMAIN=ctf.example.com
